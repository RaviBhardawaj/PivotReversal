# Copy this file to .env (same folder as Options-angel_live-ok.py) and fill in your own values.
# .env is ignored by git, so your keys never reach GitHub.

# Angel One SmartAPI (market data feed + order placement)
ANGEL_API_KEY=your_angel_api_key
ANGEL_CLIENT_ID=your_angel_client_code
ANGEL_API_SECRET=your_angel_api_secret
ANGEL_MPIN=your_4_digit_mpin
ANGEL_TOTP_SECRET=your_angel_totp_secret

# Dhan (optional). With PIN + TOTP secret the app makes a fresh access token each day.
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_PIN=your_dhan_pin
DHAN_TOTP_SECRET=your_dhan_totp_secret
DHAN_ACCESS_TOKEN=

# Jainam XTS (optional). Leave XTS_ROOT_URL empty to use Jainam's default address.
XTS_ROOT_URL=
XTS_API_KEY=your_xts_interactive_app_key
XTS_API_SECRET=your_xts_interactive_secret_key
# Only for dealer logins: the client code to trade for
XTS_CLIENT_ID=
